# Copy this file to .env.local, fill in the values, and restart the app.
# Reviews are saved even when email is not connected.

EMAIL_TRANSPORT=graph
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GRAPH_SENDER_EMAIL=reviews@yourdomain.com
EMAIL_CC=team@yourdomain.com,lead@yourdomain.com

# One Postgres database holds every review link, the team list, and the admin sign-in.
# Remote databases always use SSL and the certificate is verified.
# DATABASE_URL=postgresql://user:password@host:5432/reviews?sslmode=verify-full

# Optional one-time desk password. If omitted, the app seeds RapzterReview#2026
# and emails a reset link on the first sign-in.
# ADMIN_EMAIL=parthiban.s@rapzterdigital.com
# ADMIN_INITIAL_PASSWORD=choose-a-temporary-password

# Optional. Use this when the address in the browser is not the one clients should open.
# NEXT_PUBLIC_BASE_URL=https://reviews.yourdomain.com
