# Copy this file to .env.local, fill in the values, and restart the app.
# Reviews are saved even when email is not connected.

EMAIL_TRANSPORT=graph
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GRAPH_SENDER_EMAIL=reviews@yourdomain.com
EMAIL_CC=team@yourdomain.com,lead@yourdomain.com

# One Postgres database holds every review link and the team notification list.
# Neon, Supabase, RDS, and local Postgres all use the same variable.
# Put the same value in the host's environment (for example Vercel).
# DATABASE_URL=postgresql://user:password@host:5432/reviews?sslmode=require

# Optional. Use this when the address in the browser is not the one clients should open.
# NEXT_PUBLIC_BASE_URL=https://reviews.yourdomain.com
